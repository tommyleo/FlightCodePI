.program crsf_rx

; CRSF: 420 kbit/s, 8N1, non-inverted signal.
; The state machine runs at 8 instructions per bit and samples in the
; middle of each data bit.

    wait 0 pin 0
    set x, 7 [10]
bit_loop:
    in pins, 1
    jmp x-- bit_loop [6]
    push block

% c-sdk {
static inline void crsf_rx_program_init(PIO pio, uint sm, uint offset,
                                        uint pin, float baud)
{
    pio_sm_config config = crsf_rx_program_get_default_config(offset);
    sm_config_set_in_pins(&config, pin);
    sm_config_set_jmp_pin(&config, pin);
    sm_config_set_in_shift(&config, true, false, 32);
    sm_config_set_fifo_join(&config, PIO_FIFO_JOIN_RX);
    sm_config_set_clkdiv(&config, (float)clock_get_hz(clk_sys) / (8.0f * baud));

    pio_gpio_init(pio, pin);
    pio_sm_set_consecutive_pindirs(pio, sm, pin, 1, false);
    pio_sm_init(pio, sm, offset, &config);
    pio_sm_set_enabled(pio, sm, true);
}
%}
