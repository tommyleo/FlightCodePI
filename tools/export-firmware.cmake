# Keep the files to flash in one stable location for every CMake build.
if(FIRMWARE_BOARD STREQUAL "pico2")
    set(firmware_name "FlightCodePI-PICO2.uf2")
elseif(FIRMWARE_BOARD STREQUAL "pico2_w")
    set(firmware_name "FlightCodePI-PICO2_W.uf2")
else()
    message(FATAL_ERROR "Unsupported firmware board: ${FIRMWARE_BOARD}")
endif()
set(firmware_output "${FIRMWARE_SOURCE_DIR}/output/firmware")
file(MAKE_DIRECTORY "${firmware_output}")
configure_file("${FIRMWARE_BINARY_DIR}/FlightCodePI.uf2" "${firmware_output}/${firmware_name}" COPYONLY)
file(SHA256 "${firmware_output}/${firmware_name}" firmware_hash)
file(WRITE "${firmware_output}/${firmware_name}.sha256" "${firmware_hash}  ${firmware_name}\n")
configure_file("${FIRMWARE_SOURCE_DIR}/docs/hardware-connections.md" "${firmware_output}/hardware-connections.md" COPYONLY)
message(STATUS "Firmware: ${firmware_output}/${firmware_name}")
